# Database — the app builds its connection string from these same values,
# so the password only lives in one place. Use letters/digits only; a `$`
# in the value gets mangled by docker compose interpolation.
POSTGRES_DB=billsplit
POSTGRES_USER=billsplit
POSTGRES_PASSWORD=changeme

# App
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
SECURE_COOKIES=true
# Public URL of the app, used to build links in emails. Leave blank to derive
# it from the incoming request (set this once you're behind a real domain).
APP_BASE_URL=

# Email (optional) — used to send payment requests to guests. Leave SMTP_HOST
# blank to disable; the "Copy request link" button always works regardless.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BillSplit <noreply@example.com>
SMTP_STARTTLS=true

# Ollama - point to your running Ollama instance
OLLAMA_URL=http://host.docker.internal:11434
# Vision-capable model; llava or llama3.2-vision both work
OLLAMA_MODEL=llama3.2-vision
